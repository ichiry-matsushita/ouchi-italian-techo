<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-logo" href="/">{{ site.name }}</a>
    <nav class="site-nav" aria-label="メインメニュー">
      <ul>
        <li><a href="/articles/">記事一覧</a></li>
        {% for cat in site.categories %}
